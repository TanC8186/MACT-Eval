# MACT-Eval environment template.
# Copy to .env for local Compose; never commit real secrets.

# REQUIRED for backend startup (>= 32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MACT_JWT_SECRET=

# Optional zero-downtime key rotation (docs/operations/runbook.md section 4).
# MACT_JWT_SECRETS wins over MACT_JWT_SECRET when set: the FIRST key signs,
# ALL keys verify. Put the new key first and keep the old one after it, then
# restart: tokens signed before the rotation keep working, nobody is logged out.
# Every entry must pass the same >=32-byte check as MACT_JWT_SECRET; an empty
# entry (e.g. a trailing comma) refuses startup.
#   MACT_JWT_SECRETS=<new-key>,<old-key>
# MACT_JWT_RETIRED_AT is an ISO-8601 instant WITH an offset, e.g.
#   2026-11-06T00:00:00Z
# Once that moment passes the backend REFUSES to start until you delete the old
# key from the list and clear this variable. Deliberate: a retired key left in
# the list is a permanent token-forgery window, so it must fail loudly rather
# than be silently ignored. Set it to at least rotation time + refresh TTL (7d).
#   MACT_JWT_RETIRED_AT=
# docker-compose.yml forwards both only if you also uncomment them there.
MACT_JWT_SECRETS=
MACT_JWT_RETIRED_AT=

# Service-to-service token used by ai-service callbacks/claim/heartbeat.
# The development default is rejected when SPRING_PROFILES_ACTIVE=prod.
MACT_SERVICE_TOKEN=

# Optional: demo accounts (teacher/123456, admin/admin123, student/123456).
# Keep false for any deployment that contains real data.
MACT_DEMO_ENABLED=false

# Optional AI service settings (GPU hosts may switch device to cuda / float16).
MACT_AI_DEVICE=cpu
MACT_AI_WHISPER_DEVICE=cpu
MACT_AI_WHISPER_COMPUTE_TYPE=int8
MACT_AI_DEEPSEEK_API_KEY=

# Classroom action evidence (the checkpoint must declare classroom action labels).
# Compose: place the checkpoint in ./models/classroom-behavior.pt.
# Native service: set an absolute path to the trained SCB/SCB5 best.pt.
# Empty uses local model discovery; missing/unsupported weights produce no model action claims.
MACT_AI_BEHAVIOR_WEIGHTS=
MACT_AI_BEHAVIOR_CONFIDENCE=0.4
# Includes one overview frame; bounded to at most 6 frames per analysis window.
MACT_AI_EVIDENCE_FRAME_MAX_PER_WINDOW=4

# Optional media retention (days) and per-lesson asset quota.
# MACT_MEDIA_RETENTION_DAYS=90
# MACT_MEDIA_MAX_ASSETS_PER_LESSON=20

# Durable undelivered results + database-driven RUNNING recovery
# (docs/operations/result-delivery-and-recovery-protocol.md).
# Undelivered results live in a private MinIO prefix and are never expired by TTL;
# a delivered result may be pruned after the retention window.
# MACT_AI_RESULT_BUCKET=analysis-artifacts
# MACT_AI_RESULT_PREFIX=analysis-results
# MACT_AI_RESULT_RETENTION_AFTER_DELIVERY_SECONDS=604800
# MACT_AI_RESULT_PENDING_ALERT_SECONDS=900

# Readiness: /live is liveness only; /ready needs recent queue communication.
# MACT_AI_READY_STALE_SECONDS=15
# MACT_AI_READY_PING_TIMEOUT_SECONDS=2

# Backend recovery of RUNNING jobs whose lease expired (V28).
# MACT_RECOVERY_ENABLED=true
# MACT_RECOVERY_INTERVAL_MS=30000
# MACT_RECOVERY_BATCH_SIZE=20
# MACT_RECOVERY_LEASE_GRACE_SECONDS=60
# MACT_RECOVERY_MAX_ATTEMPTS=3
# MACT_RECOVERY_RETRY_BACKOFF_SECONDS=120
# MACT_RESULT_BUCKET=analysis-artifacts
# MACT_RESULT_PREFIX=analysis-results
